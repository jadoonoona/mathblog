---
import type { InterestArea } from '../data/home';
const { area } = Astro.props as { area: InterestArea };
---

<a class="interest-card" href={area.link}>
    <div class="card-kicker"><span>{area.number}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
    <h3>{area.title}</h3>
    <p>{area.description}</p>
    <ul class="topic-list">{area.topics.map(topic => <li>{topic}</li>)}</ul>
    <span class="text-link">{area.linkLabel} <span aria-hidden="true">→</span></span>
</a>