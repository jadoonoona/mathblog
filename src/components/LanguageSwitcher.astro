---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isKorean = pathname.startsWith(`${base}ko`);
const isRestaurantJournal = pathname.replace(/\/$/, '').endsWith('/blog/korean-restaurants');
const isAbout = pathname.endsWith('/about/');
const isMathNotes = pathname.endsWith('/math-notes/');

const isMidterm = pathname.replace(/\/$/, '').endsWith('/projects/nasdaq-after-us-midterm-elections');
const isMathProjects = pathname.replace(/\/$/, '').endsWith('/projects/mathematics');
const isPortfolio = pathname.replace(/\/$/, '').endsWith('/projects/hotel-asset-management/portfolio');
const isHotel = pathname.replace(/\/$/, '').endsWith('/projects/hotel-asset-management');
const englishPath = isRestaurantJournal ? `${base}blog/korean-restaurants/` : isMidterm ? `${base}projects/nasdaq-after-us-midterm-elections/` : isMathProjects ? `${base}projects/mathematics/` : isPortfolio ? `${base}projects/hotel-asset-management/portfolio/` : isHotel ? `${base}projects/hotel-asset-management/` : isAbout
    ? `${base}about/`
    : isMathNotes
        ? `${base}math-notes/`
        : base;
const koreanPath = isRestaurantJournal ? `${base}ko/blog/korean-restaurants/` : isMidterm ? `${base}ko/projects/nasdaq-after-us-midterm-elections/` : isMathProjects ? `${base}ko/projects/mathematics/` : isPortfolio ? `${base}ko/projects/hotel-asset-management/portfolio/` : isHotel ? `${base}ko/projects/hotel-asset-management/` : isAbout
    ? `${base}ko/about/`
    : isMathNotes
        ? `${base}ko/math-notes/`
        : `${base}ko/`;
---

<div class="language-switcher" aria-label="Language selector">
    <a class:list={{ 'language-active': !isKorean }} href={englishPath}>EN</a>
    <span aria-hidden="true">|</span>
    <a class:list={{ 'language-active': isKorean }} href={koreanPath}>한국어</a>
</div>
