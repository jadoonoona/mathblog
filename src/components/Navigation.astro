---
const base = import.meta.env.BASE_URL;
const isKorean = Astro.url.pathname.startsWith(`${base}ko`);
const homePath = isKorean ? `${base}ko/` : base;
const aboutPath = isKorean ? `${base}ko/about/` : `${base}about/`;
---

<div id="main-menu" class="navigation">
    <button class="menu-close" aria-label="Close Menu">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
    <div class="nav-links">
        <a href={homePath}>{isKorean ? '홈' : 'Home'}</a>
        <a href={aboutPath}>{isKorean ? '소개' : 'About'}</a>
        <a href={isKorean ? `${base}ko/math-notes/` : `${base}#areas`}>{isKorean ? '수학·통계' : 'Math & Stats'}</a>
        <a href={isKorean ? `${base}ko/#areas` : `${base}#areas`}>{isKorean ? '데이터' : 'Data'}</a>
        <a href={isKorean ? `${base}ko/#projects` : `${base}#projects`}>{isKorean ? '프로젝트' : 'Projects'}</a>
        <a href={`${base}blog/`}>{isKorean ? '블로그' : 'Blog'}</a>
    </div>
</div>
