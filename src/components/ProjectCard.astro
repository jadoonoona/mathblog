---
import type { FeaturedProject } from '../data/home';
const { project } = Astro.props as { project: FeaturedProject };
const isExternal = project.link.startsWith('http');
---

<article class:list={["project-card", project.featured && "project-card-featured"]}>
    <div class="project-card-top"><span class="project-number">{project.number}</span><span class="project-status">{project.featured ? 'In progress' : 'On the horizon'}</span></div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <div class="tag-list">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div>
    <a class="text-link" href={project.link} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>{project.linkLabel} <span aria-hidden="true">↗</span></a>
</article>
