---
import InterestCard from './InterestCard.astro';
import type { InterestArea } from '../data/home';
const { areas, lang = 'en' } = Astro.props as { areas: InterestArea[]; lang?: 'en' | 'ko' };
const base = import.meta.env.BASE_URL;
---
<section id="areas" class="project-explorer" aria-labelledby="areas-title" hidden>
    <h2 id="areas-title">{lang === 'ko' ? '관심 분야별 프로젝트' : 'Explore projects by area'}</h2>
    <div class="interest-grid">{areas.map(area => <InterestCard area={{ ...area, link: `${base}${area.link}` }} />)}</div>
</section>
<noscript><style>#areas[hidden] { display: block !important; }</style></noscript>
<script>
    const toggle = document.querySelector<HTMLButtonElement>('[data-project-toggle]');
    const panel = document.querySelector<HTMLElement>('#areas');
    if (toggle && panel) {
        const setOpen = (open: boolean) => {
            panel.hidden = !open;
            toggle.setAttribute('aria-expanded', String(open));
        };
        toggle.addEventListener('click', () => setOpen(panel.hidden));
        const openFromHash = () => {
            if (window.location.hash === '#areas') setOpen(true);
        };
        openFromHash();
        window.addEventListener('hashchange', openFromHash);
    }
</script>
