---
import Layout from './Layout.astro';
import '../styles/blog.css';

const { frontmatter } = Astro.props;
const financeUrl = `${import.meta.env.BASE_URL}ko/projects/finance/`;
const dateStr = new Date(frontmatter.date).toLocaleDateString('ko-KR', {
    year: 'numeric', month: 'long', day: 'numeric',
});
---

<Layout lang="ko" pageTitle={frontmatter.title} description={frontmatter.description}>
    <div class="page-container">
        <div class="post-content">
            <div class="post-header">
                <a href={financeUrl} class="back-link">← Finance 프로젝트</a>
                <h1 class="post-title">{frontmatter.title}</h1>
                <div class="post-meta">
                    <time datetime={frontmatter.date}>{dateStr}</time>
                    {frontmatter.tags && (
                        <div class="post-tags">
                            {frontmatter.tags.map((tag: string) => <span class="tag">{tag}</span>)}
                        </div>
                    )}
                </div>
                {frontmatter.description && <p class="post-description">{frontmatter.description}</p>}
            </div>
            <article class="post-body"><slot /></article>
            <div class="post-footer">
                <a href={financeUrl} class="back-link">← Finance 프로젝트로 돌아가기</a>
            </div>
        </div>
    </div>
</Layout>
