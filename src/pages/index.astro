---
import Layout from '../layouts/Layout.astro';
import InterestCard from '../components/InterestCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { FEATURED_PROJECTS, INTEREST_AREAS } from '../data/home';
import '../styles/home.css';

const base = import.meta.env.BASE_URL;
---

<Layout pageTitle="" description="Finance, mathematics, data, and technology explored through practical notes, projects, and quantitative thinking.">
	<div class="home-page">
		<section class="portfolio-hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Finance <span>×</span> Mathematics <span>×</span> Data <span>×</span> Technology</p>
				<h1 id="hero-title">Hi, I’m Jihee.<br />Welcome to my blog.</h1>
				<p class="hero-lede">A place where I share what I learn, explore, and build.</p>
				<p class="hero-intro">Finance by profession, curious about numbers, data, and technology.</p>
				<div class="hero-actions"><a class="button button-primary" href="#projects">Explore projects <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={`${base}blog/`}>Read the blog <span aria-hidden="true">→</span></a><a class="quiet-link" href={`${base}about/`}>About me</a></div>
			</div>
		</section>

		<section class="home-section journey-section" id="journey" aria-labelledby="journey-title"><div class="section-heading"><p class="eyebrow">01 / The throughline</p><h2 id="journey-title"></h2></div><div class="journey-grid"><p class="section-lede">My work starts with finance and risk, and keeps expanding through the questions that sit underneath them.</p><div class="journey-copy"><p>I study mathematics and statistics to understand the structure of a problem, use Python, SQL, and data analysis to test it, then build practical tools that make the result useful.</p><p>That takes me from investment and property to equity, macroeconomics, and project finance. It also led me to build <a href="https://ourtripplan.com" target="_blank" rel="noopener noreferrer">Our Trip Plan</a>, a mobile product for making shared travel simpler.</p></div></div><div class="principle-line"><span></span><strong>Finance</strong><span></span><strong>Mathematics &amp; statistics</strong><span></strong><span><strong>Technology</strong></div></section>

		<section class="home-section areas-section" id="areas" aria-labelledby="areas-title"><div class="section-heading heading-row"><div><p class="eyebrow">02 / Areas I explore</p><h2 id="areas-title"></h2></div><span class="section-index">04 fields of study</span></div><div class="interest-grid">{INTEREST_AREAS.map(area => <InterestCard area={area} />)}</div></section>

		<section class="home-section projects-section" id="projects" aria-labelledby="projects-title"><div class="section-heading heading-row"><div><p class="eyebrow">03 / Projects</p><h2 id="projects-title"></h2></div><a class="text-link" href={`${base}blog/`}>All writing <span aria-hidden="true">↗</span></a></div><div class="project-grid">{FEATURED_PROJECTS.map(project => <ProjectCard project={project} />)}</div></section>

	</div>
</Layout>
