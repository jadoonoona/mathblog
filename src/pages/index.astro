---
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../constants';
import InterestCard from '../components/InterestCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { FEATURED_PROJECTS, INTEREST_AREAS } from '../data/home';
import '../styles/home.css';

interface Post { title: string; date: string; description?: string; tags?: string[]; hidden?: boolean; }
const base = import.meta.env.BASE_URL;
const postFiles = import.meta.glob<{ frontmatter: Post }>('./blog/*.md', { eager: true });
const latestPosts = Object.entries(postFiles).map(([path, mod]) => ({ ...mod.frontmatter, url: `${base}blog/${path.replace('./blog/', '').replace('.md', '')}/` })).filter(post => !post.hidden).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 4);
function formatDate(date: string) { return new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); }
---

<Layout pageTitle="" description="Finance, mathematics, data, and technology explored through practical notes, projects, and quantitative thinking.">
	<div class="home-page">
		<section class="portfolio-hero" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">Finance <span>×</span> Mathematics <span>×</span> Data <span>×</span> Technology</p>
				<h1 id="hero-title">Hi, I’m Jihee. Welcome to my corner of the internet.</h1>
				<p class="hero-lede">I explore financial markets and real-world problems through quantitative thinking, data analysis, and technology.</p>
				<p class="hero-intro">Finance professional, quantitative learner, and product builder.</p>
				<div class="hero-actions"><a class="button button-primary" href="#projects">Explore projects <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={`${base}blog/`}>Read the blog <span aria-hidden="true">→</span></a><a class="quiet-link" href={`${base}about/`}>About me</a></div>
			</div>
			<a class="scroll-cue" href="#journey"><span></span> Scroll to explore</a>
		</section>

		<section class="home-section journey-section" id="journey" aria-labelledby="journey-title"><div class="section-heading"><p class="eyebrow">01 / The throughline</p><h2 id="journey-title">One way of thinking, many applications.</h2></div><div class="journey-grid"><p class="section-lede">My work starts with finance and risk, and keeps expanding through the questions that sit underneath them.</p><div class="journey-copy"><p>I study mathematics and statistics to understand the structure of a problem, use Python, SQL, and data analysis to test it, then build practical tools that make the result useful.</p><p>That takes me from investment and property to equity, macroeconomics, and project finance. It also led me to build <a href="#our-trip-plan">Our Trip Plan</a>, a mobile product for making shared travel simpler.</p></div></div><div class="principle-line"><span>Domain</span><strong>Finance</strong><span>Foundation</span><strong>Mathematics &amp; statistics</strong><span>Tool</span><strong>Data</strong><span>Output</span><strong>Technology</strong></div></section>

		<section class="home-section areas-section" id="areas" aria-labelledby="areas-title"><div class="section-heading heading-row"><div><p class="eyebrow">02 / Areas I explore</p><h2 id="areas-title">Curiosity with a practical edge.</h2></div><span class="section-index">04 fields of study</span></div><div class="interest-grid">{INTEREST_AREAS.map(area => <InterestCard area={area} />)}</div></section>

		<section class="home-section projects-section" id="projects" aria-labelledby="projects-title"><div class="section-heading heading-row"><div><p class="eyebrow">03 / Selected work</p><h2 id="projects-title">Ideas, models, and things made.</h2></div><a class="text-link" href={`${base}blog/`}>All writing <span aria-hidden="true">↗</span></a></div><div class="project-grid">{FEATURED_PROJECTS.map(project => <ProjectCard project={project} />)}</div></section>

		<section class="trip-spotlight" id="our-trip-plan" aria-labelledby="trip-title"><div class="trip-mark" aria-hidden="true"><span>OTP</span><i></i><i></i><i></i></div><div class="trip-content"><p class="eyebrow">04 / Product spotlight</p><h2 id="trip-title">Our Trip Plan</h2><p class="trip-lede">Planning a trip together should feel like part of the adventure, not another spreadsheet.</p><p>A mobile product for collaborative itineraries, travelmate invitations, expense tracking, and places management.</p><div class="tag-list"><span class="tag">Mobile development</span><span class="tag">React Native</span><span class="tag">Supabase</span></div><a class="button button-dark" href="#contact">View the project <span aria-hidden="true">↗</span></a></div></section>

		<section class="home-section writing-section" aria-labelledby="writing-title"><div class="section-heading heading-row"><div><p class="eyebrow">05 / Latest writing</p><h2 id="writing-title">Notes from the workbench.</h2></div><a class="text-link" href={`${base}blog/`}>View all posts <span aria-hidden="true">↗</span></a></div><div class="writing-list">{latestPosts.map((post, index) => <a class="writing-item" href={post.url}><span class="writing-number">0{index + 1}</span><div><span class="writing-meta">{post.tags?.[0] ?? 'Notebook'} · {formatDate(post.date)}</span><h3>{post.title}</h3><p>{post.description}</p></div><span class="writing-arrow" aria-hidden="true">↗</span></a>)}</div></section>

		<section class="contact-section" id="contact" aria-labelledby="contact-title"><p class="eyebrow">06 / Keep in touch</p><h2 id="contact-title">Always learning, analysing, and building.</h2><p>Explore the notes, follow the projects, or find me on LinkedIn.</p><div class="contact-links"><a class="button button-primary" href={`${base}about/`}>About me <span aria-hidden="true">→</span></a>{SITE_DATA.linkedin && <a class="button button-secondary" href={`https://linkedin.com/in/${SITE_DATA.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}</div></section>
	</div>
</Layout>
