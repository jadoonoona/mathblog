---
import { websitesPost } from '../../../data/websites-post';
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/blog.css';
import { koreanRestaurantPost } from '../../../data/korean-restaurants/post';

interface Post {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
    url: string;
    hidden?: boolean;
}

const postFiles = import.meta.glob<{ frontmatter: Post }>('../../blog/*.md', { eager: true });
const sorted: Post[] = Object.entries(postFiles)
    .map(([path, mod]) => ({
        ...mod.frontmatter,
        url: `${import.meta.env.BASE_URL}blog/` + path.replace('../../blog/', '').replace('.md', '') + '/',
    }))
    .concat([koreanRestaurantPost, websitesPost])
    .filter(post => !post.hidden)
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString('ko-KR', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
    });
}
---

<Layout pageTitle="블로그" lang="ko" description="금융, 여행, 공부하며 배운 내용을 기록합니다.">
    <div class="page-container">
        <h1>블로그</h1>

        <p class="intro-text">
            Occasional writing on random things.
        </p>

        <section id="posts" aria-label="블로그 글">
            <div class="blog-grid" id="blog-grid">
                {sorted.map(post => (
                    <a href={post.url} class="blog-card">
                        <div class="blog-card-inner">
                            <span class="blog-card-date">{formatDate(post.date)}</span>
                            <div>
                                <h3 class="blog-card-title">{post.title}</h3>
                                {post.description && (
                                    <p class="blog-card-description">{post.description}</p>
                                )}
                                {post.tags && (
                                    <div class="blog-card-tags">
                                        {post.tags.map((tag: string) => (
                                            <span class="tag">{tag}</span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>



    </div>
</Layout>

<style>
    #blog-grid > .blog-card:first-child {
        border-top: none;
    }
</style>
