---
import Layout from '../../layouts/Layout.astro';
import InterestCard from '../../components/InterestCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { FEATURED_PROJECTS_KO, INTEREST_AREAS_KO } from '../../data/home-ko';
import '../../styles/home.css';

const base = import.meta.env.BASE_URL;
---

<Layout pageTitle="홈" lang="ko" description="금융, 수학, 데이터, 를 통해 현실의 문제를 탐구하는 지희의 포트폴리오입니다.">
    <div class="home-page">
        <section class="portfolio-hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">금융 <span>×</span> 수학 <span>×</span> 데이터 <span></span></p><h1 id="hero-title">안녕하세요, 함지희입니다.</h1><p class="hero-lede">공부하고 직접 적용해보며 배운 것들을 기록합니다.</p><p class="hero-intro">금융업계에 재직중이며 수학, 컴퓨터공학을 공부하고있습니다. 제가 배운 내용들, 만든 작업물들에 대한 기록을 남기고 있습니다.</p><div class="hero-actions"><a class="button button-primary" href="#projects">프로젝트 보기 <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={`${base}blog/`}>블로그 읽기 <span aria-hidden="true">→</span></a><a class="quiet-link" href={`${base}ko/about/`}>소개 보기</a></div></div></section>

        <section class="home-section journey-section" id="journey" aria-labelledby="journey-title"><div class="section-heading"><p class="eyebrow">01 / 소개</p><h2 id="journey-title"> </h2></div><div class="journey-grid"><p class="section-lede"> 파생상품 위험 관리 분야에서 일하고 있으며 금융 데이터를 다루는 일을 하고 있습니다.</p><div class="journey-copy"><p>수학과 통계로 문제의 구조를 이해하고, Python과 SQL, 데이터 분석으로 검증한 뒤, 결과를 실제로 쓸 수 있는 도구로 만듭니다.</p><p>투자와 부동산, 주식, 거시경제, 프로젝트 파이낸스가 저의 주요 관심 분야입니다. 친구, 가족들과의 여행을 더 쉽게 계획하기 위한 모바일 앱 <a href="https://ourtripplan.com" target="_blank" rel="noopener noreferrer">Our Trip Plan</a>도 만들었습니다.</p></div></div><div class="principle-line"><span></span><strong>금융</strong><span></span><strong>수학과 통계</strong><span></span><strong>데이터</strong><span></span><strong></strong></div></section>

        <section class="home-section areas-section" id="areas" aria-labelledby="areas-title"><div class="section-heading heading-row"><div><p class="eyebrow">02 / 기록중인 것들</p><h2 id="areas-title"></h2></div><span class="section-index"></span></div><div class="interest-grid">{INTEREST_AREAS_KO.map(area => <InterestCard area={{ ...area, link: area.link.startsWith('#') ? area.link : `${base}${area.link}` }} />)}</div></section>

        <section class="home-section projects-section" id="projects" aria-labelledby="projects-title"><div class="section-heading heading-row"><div><p class="eyebrow">03 / 주요 작업</p><h2 id="projects-title"></h2></div><a class="text-link" href={`${base}blog/`}>전체 글 보기 <span aria-hidden="true">↗</span></a></div><div class="project-grid">{FEATURED_PROJECTS_KO.map(project => <ProjectCard project={{ ...project, link: project.link.startsWith('http') || project.link.startsWith('#') ? project.link : `${base}${project.link}` }} />)}</div></section>

    </div>
</Layout>
