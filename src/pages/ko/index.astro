---
import Layout from '../../layouts/Layout.astro';
import { SITE_DATA } from '../../constants';
import InterestCard from '../../components/InterestCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { FEATURED_PROJECTS_KO, INTEREST_AREAS_KO } from '../../data/home-ko';
import '../../styles/home.css';

interface Post { title: string; date: string; description?: string; tags?: string[]; hidden?: boolean; }
const base = import.meta.env.BASE_URL;
const postFiles = import.meta.glob<{ frontmatter: Post }>('../blog/*.md', { eager: true });
const latestPosts = Object.entries(postFiles).map(([path, mod]) => ({ ...mod.frontmatter, url: `${base}blog/${path.replace('../blog/', '').replace('.md', '')}/` })).filter(post => !post.hidden).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 4);
function formatDate(date: string) { return new Date(date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }); }
---

<Layout pageTitle="홈" lang="ko" description="금융, 수학, 데이터, 기술을 통해 현실의 문제를 탐구하는 지희의 포트폴리오입니다.">
    <div class="home-page">
        <section class="portfolio-hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">금융 <span>×</span> 수학 <span>×</span> 데이터 <span>×</span> 기술</p><h1 id="hero-title">안녕하세요, 함지희입니다.</h1><p class="hero-lede">정량적 사고와 데이터 분석, 기술을 통해 금융시장과 현실의 문제를 탐구합니다.</p><p class="hero-intro">금융업계에 재직중이며 수학, 컴퓨터공학을 공부하고있습니다. 제가 배운 내용들, 만든 작업물들에 대한 기록을 남기고 있습니다.</p><div class="hero-actions"><a class="button button-primary" href="#projects">프로젝트 보기 <span aria-hidden="true">↗</span></a><a class="button button-secondary" href={`${base}blog/`}>블로그 읽기 <span aria-hidden="true">→</span></a><a class="quiet-link" href={`${base}about/`}>소개 보기</a></div></div><a class="scroll-cue" href="#journey"><span></span> 아래로 둘러보기</a></section>

        <section class="home-section journey-section" id="journey" aria-labelledby="journey-title"><div class="section-heading"><p class="eyebrow">01 / 연결고리</p><h2 id="journey-title">하나의 사고방식, 다양한 적용.</h2></div><div class="journey-grid"><p class="section-lede">저의 일은 금융과 리스크에서 시작해, 그 아래에 있는 질문들을 따라 확장됩니다.</p><div class="journey-copy"><p>수학과 통계로 문제의 구조를 이해하고, Python과 SQL, 데이터 분석으로 검증한 뒤, 결과를 실제로 쓸 수 있는 도구로 만듭니다.</p><p>이 관심은 투자와 부동산, 주식, 거시경제, 프로젝트 파이낸스로 이어집니다. 동시에 함께하는 여행을 더 쉽게 만들기 위한 모바일 제품 <a href="#our-trip-plan">Our Trip Plan</a>도 만들었습니다.</p></div></div><div class="principle-line"><span>영역</span><strong>금융</strong><span>기반</span><strong>수학과 통계</strong><span>도구</span><strong>데이터</strong><span>결과</span><strong>기술</strong></div></section>

        <section class="home-section areas-section" id="areas" aria-labelledby="areas-title"><div class="section-heading heading-row"><div><p class="eyebrow">02 / 탐구하는 분야</p><h2 id="areas-title">호기심을 실용적인 방향으로.</h2></div><span class="section-index">4개의 관심 분야</span></div><div class="interest-grid">{INTEREST_AREAS_KO.map(area => <InterestCard area={{ ...area, link: area.link.startsWith('#') ? area.link : `${base}${area.link}` }} />)}</div></section>

        <section class="home-section projects-section" id="projects" aria-labelledby="projects-title"><div class="section-heading heading-row"><div><p class="eyebrow">03 / 주요 작업</p><h2 id="projects-title">아이디어, 모델, 그리고 만든 것들.</h2></div><a class="text-link" href={`${base}blog/`}>전체 글 보기 <span aria-hidden="true">↗</span></a></div><div class="project-grid">{FEATURED_PROJECTS_KO.map(project => <ProjectCard project={{ ...project, link: project.link.startsWith('#') ? project.link : `${base}${project.link}` }} />)}</div></section>

        <section class="trip-spotlight" id="our-trip-plan" aria-labelledby="trip-title"><div class="trip-mark" aria-hidden="true"><span>OTP</span><i></i><i></i><i></i></div><div class="trip-content"><p class="eyebrow">04 / 제품 소개</p><h2 id="trip-title">Our Trip Plan</h2><p class="trip-lede">함께하는 여행 계획은 또 하나의 스프레드시트가 아니라 여행의 일부여야 합니다.</p><p>협업 일정 관리, 여행 멤버 초대, 경비 기록, 장소 관리를 지원하는 모바일 제품입니다.</p><div class="tag-list"><span class="tag">모바일 개발</span><span class="tag">React Native</span><span class="tag">Supabase</span></div><a class="button button-dark" href="#contact">프로젝트 보기 <span aria-hidden="true">↗</span></a></div></section>

        <section class="home-section writing-section" aria-labelledby="writing-title"><div class="section-heading heading-row"><div><p class="eyebrow">05 / 최근 글</p><h2 id="writing-title">작업대에서 적어 내려간 노트.</h2></div><a class="text-link" href={`${base}blog/`}>전체 글 보기 <span aria-hidden="true">↗</span></a></div><div class="writing-list">{latestPosts.map((post, index) => <a class="writing-item" href={post.url}><span class="writing-number">0{index + 1}</span><div><span class="writing-meta">{post.tags?.[0] ?? '노트'} · {formatDate(post.date)}</span><h3>{post.title}</h3><p>{post.description}</p></div><span class="writing-arrow" aria-hidden="true">↗</span></a>)}</div></section>

        <section class="contact-section" id="contact" aria-labelledby="contact-title"><p class="eyebrow">06 / 연락하기</p><h2 id="contact-title">계속 배우고, 분석하고, 만들어갑니다.</h2><p>노트를 둘러보고, 프로젝트를 살펴보거나 LinkedIn에서 연결해 주세요.</p><div class="contact-links"><a class="button button-primary" href={`${base}about/`}>소개 보기 <span aria-hidden="true">→</span></a>{SITE_DATA.linkedin && <a class="button button-secondary" href={`https://linkedin.com/in/${SITE_DATA.linkedin}`} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}</div></section>
    </div>
</Layout>