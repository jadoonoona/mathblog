---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { FEATURED_PROJECTS_KO, INTEREST_AREAS_KO } from '../../../data/home-ko';
import '../../../styles/home.css';

export function getStaticPaths() {
    return INTEREST_AREAS_KO.map(area => ({
        params: { category: area.projectCategory },
        props: {
            area,
            projects: FEATURED_PROJECTS_KO.filter(project => project.category === area.projectCategory),
        },
    }));
}

const { area, projects } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout lang="ko" pageTitle={area.title} description={area.description}>
    <div class="home-page">
        <section class="home-section projects-section" aria-labelledby="category-title">
            <div class="section-heading">
                <p class="eyebrow">프로젝트 / {area.title}</p>
                <h1 id="category-title">{area.title}</h1>
                <p>{area.description}</p>
                <a class="text-link" href={`${base}ko/#areas`}>← 전체 분야 보기</a>
            </div>
            {projects.length > 0 ? (
                <div class="project-grid">
                    {projects.map(project => (
                        <ProjectCard project={{
                            ...project,
                            link: project.link.startsWith('http') ? project.link : `${base}${project.link}`,
                        }} />
                    ))}
                </div>
            ) : (
                <p class="category-empty">아직 이 분야의 프로젝트가 없습니다. 조금만 기다려 주세요.</p>
            )}
        </section>
    </div>
</Layout>
