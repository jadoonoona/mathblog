import ProjectExplorer from '../../../components/ProjectExplorer.astro';
import { INTEREST_AREAS_KO } from '../../../data/home-ko';
import '../../../styles/home.css';
---

<Layout pageTitle="프로젝트" lang="ko" description="관심 분야별 프로젝트와 작업물을 살펴보세요.">
    <div class="home-page">
        <section class="home-section projects-section" aria-labelledby="projects-title">
            <div class="section-heading">
                <h1 id="projects-title">프로젝트</h1>
            </div>
            <ProjectExplorer areas={INTEREST_AREAS_KO} lang="ko" />
        </section>
    </div>
</Layout>
