---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { FEATURED_PROJECTS, INTEREST_AREAS } from '../../data/home';
import '../../styles/home.css';

export function getStaticPaths() {
    return INTEREST_AREAS.map(area => ({
        params: { category: area.projectCategory },
        props: {
            area,
            projects: FEATURED_PROJECTS.filter(project => project.category === area.projectCategory),
        },
    }));
}

const { area, projects } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Layout pageTitle={area.title} description={area.description}>
    <div class="home-page">
        <section class="home-section projects-section" aria-labelledby="category-title">
            <div class="section-heading">
                <p class="eyebrow">Projects / {area.title}</p>
                <h1 id="category-title">{area.title}</h1>
                <p>{area.description}</p>
                <a class="text-link" href={`${base}#areas`}>← All areas</a>
            </div>
            {projects.length > 0 ? (
                <div class="project-grid">
                    {projects.map(project => (
                        <ProjectCard project={{
                            ...project,
                            link: project.link.startsWith('http') ? project.link : `${base}${project.link}`,
                        }} />
                    ))}
                </div>
            ) : (
                <p class="category-empty">No projects in this area yet. Check back soon.</p>
            )}
        </section>
    </div>
</Layout>
